DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_CONFIG_PROFILE=your_profile
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id
DATABRICKS_SERVING_ENDPOINT_NAME=your_serving_endpoint_name
DATABRICKS_VS_INDEX_NAME=media_dev.ott_recommendations.movie_recommendations_search
