# MLFLOW_EXPERIMENT_ID=your_mlflow_experiment_id
MLFLOW_TRACKING_URI=databricks
DATABRICKS_CATALOG=media_dev
DATABRICKS_SCHEMA=ott_recommendations
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=media-ott-consumer-app
NODE_ENV=development
